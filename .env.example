# Copy this file to .env and fill with your Aiven MySQL credentials
# DO NOT commit the real .env with secrets to source control

# Aiven MySQL connection values
DB_HOST=your-service-host.aivencloud.com
DB_PORT=3306
DB_USER=your_aiven_user
DB_PASS=your_aiven_password
DB_NAME=your_database_name
DB_TYPE=mysqli
DB_PREFIX=dotp_

# SSL for MySQL (optional)
# Set to the path inside the container where your Aiven CA cert will be mounted.
# Example: MYSQL_SSL_CA=/certs/aiven-ca.pem
MYSQL_SSL_CA=/certs/aiven-ca.pem
# Mode values: DISABLED, REQUIRED, VERIFY_CA, VERIFY_IDENTITY
# - DISABLED: Do not attempt SSL
# - REQUIRED: Use SSL but do not verify server certificate
# - VERIFY_CA: Use SSL and verify server cert against CA
# - VERIFY_IDENTITY: Verify certificate and host identity (best security if supported)
MYSQL_SSL_MODE=VERIFY_CA

# Notes:
# - If Aiven requires SSL and your environment needs a CA file, download the CA cert from the Aiven console
#   and place it in the project's `certs/` folder. It will be mounted as read-only into the container at /certs.
# - Don't forget to allowlist your container host's public IP in the Aiven service access control if necessary.
